@startuml
title UC-03＋UC-04 出场结算 SSD（AI-辅助）
actor 车主
participant "机场停车系统" as system
车主 -> system : requestExit(sessionId, exitTime, exceptionType?)
system --> 车主 : billId, feeItems, amountDueCents
车主 -> system : completeExit(sessionId, simulatedResult)
alt 支付失败
  system --> 车主 : EXIT_PENDING_PAYMENT
else 支付成功但释放失败
  system --> 车主 : PAID_PENDING_RELEASE
  车主 -> system : completeExit(sessionId, SUCCESS)
  system --> 车主 : CLOSED
else 成功
  system --> 车主 : CLOSED
end
opt 需要发票
  车主 -> system : requestInvoice(billId, invoiceTitle)
  system --> 车主 : invoiceRequestId, REQUESTED
end
@enduml
