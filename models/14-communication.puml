@startuml
title 出场结算通信图（AI-辅助）
object "车主界面" as ui
object "access-service" as access
object "space-service" as space
object "pass-service" as pass
object "billing-service" as billing
ui --> access : 1. requestExit(sessionId,exitTime)
access --> pass : 1.1 eligibility(plate,sessionId)
access --> space : 1.2 settle(spaceId,sessionId)
access --> billing : 1.3 createBill(snapshot)
ui --> access : 2. completeExit(SUCCESS)
access --> pass : 2.1 deduct(monthlyPassId,amount) [适用时]
access --> billing : 2.2 pay(billId)
access --> pass : 2.3 refundRemainder [适用时]
access --> space : 2.4 release(spaceId,sessionId)
@enduml
