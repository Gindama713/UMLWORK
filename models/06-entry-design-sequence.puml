@startuml
title UC-02 入场设计顺序图（AI-辅助）
actor 收费员
participant "AccessController" as controller
participant "AccessService" as access
database "parking_access" as db
participant "PassClient" as pass
participant "SpaceClient" as space
收费员 -> controller : POST /api/v1/access/entries
controller -> access : enter(request,key)
note over access,db
  独立锁事务持有请求键行锁，
  同键并发重试等待原入场完成；
  入场记录单独持久化以支持崩溃重试。
  占位仍是跨服务调用，失败须补偿；
  这不是分布式数据库事务。
end note
access -> db : INSERT ENTERING（唯一 active_plate/request_key）
opt 预约位
  access -> pass : consume(reservationId,sessionId)
  pass --> access : spaceId, prepaidCents
end
access -> space : available(type) / occupy(spaceId,sessionId)
space --> access : 车位位置与 OCCUPIED
access -> db : UPDATE PARKED
access --> controller : SessionView
controller --> 收费员 : parkingSessionId, 车位位置
alt 入场失败
  access -> space : release(spaceId,sessionId)
  opt 已核销预约
    access -> pass : release-consumption(reservationId,sessionId)
  end
  access -> db : UPDATE ENTRY_FAILED（补偿成功时）
end
@enduml
