@startuml
title access-service 设计类图（AI-辅助；字段与签名按实现）
skinparam classAttributeIconSize 0

package "access-service" {
  class AccessController {
    -service: AccessService
    ~enter(request: EntryRequest, key: String): Envelope<SessionView>
    ~locate(plateNumber: String): Envelope<SessionView>
    ~requestExit(sessionId: String, request: ExitRequest, key: String): Envelope<ExitView>
    ~complete(sessionId: String, request: CompleteRequest, key: String): Envelope<CompleteView>
  }
  class AccessService {
    -repo: AccessRepository
    -spaces: SpaceClient
    -billing: BillingClient
    -passes: PassClient
    ~enter(input: EntryRequest, key: String): SessionView
    ~locate(rawPlate: String): SessionView
    ~requestExit(id: String, input: ExitRequest, key: String): ExitView
    ~completeExit(id: String, input: CompleteRequest, key: String): CompleteView
  }
  class AccessRepository {
    -jdbc: JdbcTemplate
    -mapper: RowMapper<SessionRow>
    ~insert(id: String, plate: String, type: String, reservationId: String, entry: OffsetDateTime, key: String, payload: String): void
    ~chooseSpace(id: String, space: SpaceView): void
    ~reserveExit(id: String, intent: ExitIntent): ExitIntent
    ~exitRequested(id: String, exit: OffsetDateTime, billId: String, exception: String, operator: String, monthlyPassId: String): void
    ~paid(id: String): void
    ~closed(id: String): void
  }
  interface "SpaceClient" as AccessSpaceClient {
    +occupy(spaceId: String, key: String, body: SessionRef): Envelope<SpaceView>
    +release(spaceId: String, key: String, body: SessionRef): Envelope<SpaceView>
    +settle(spaceId: String, key: String, body: SessionRef): Envelope<ChargingFees>
  }
  interface "PassClient" as AccessPassClient {
    +eligibility(plate: String, entry: String, exit: String, spaceType: String, parkingSessionId: String): Envelope<BenefitView>
    +deduct(id: String, key: String, body: DeductionRequest): Envelope<Object>
  }
  interface "BillingClient" as AccessBillingClient {
    +createBill(key: String, body: BillRequest): Envelope<BillView>
    +bill(billId: String): Envelope<BillView>
    +pay(billId: String, key: String, body: PaymentRequest): Envelope<PaymentView>
  }
  AccessController "1" --> "1" AccessService : service
  AccessService "1" --> "1" AccessRepository : repo
  AccessService "1" --> "1" AccessSpaceClient : spaces
  AccessService "1" --> "1" AccessPassClient : passes
  AccessService "1" --> "1" AccessBillingClient : billing
}
@enduml

@startuml
title billing-service 设计类图（AI-辅助；字段与签名按实现）
skinparam classAttributeIconSize 0
package "billing-service" {
  class BillingController {
    -billing: BillingService
    ~createBill(request: BillRequest, key: String, http: HttpServletRequest): ApiResponse<BillView>
    ~internalPay(billId: String, request: PaymentRequest, key: String, http: HttpServletRequest): ApiResponse<PaymentView>
    ~invoice(billId: String, request: InvoiceRequest, key: String, http: HttpServletRequest): ApiResponse<InvoiceView>
  }
  class BillingService {
    -jdbc: JdbcTemplate
    -json: ObjectMapper
    -pricing: ParkingPricing
    ~createBill(request: BillRequest, key: String): BillView
    ~pay(billId: String, request: PaymentRequest, key: String, allowMonthly: boolean): PaymentView
    ~requestInvoice(billId: String, request: InvoiceRequest, key: String): InvoiceView
  }
  class ParkingPricing {
    -currentRates: Supplier<PricingProperties>
    ~calculate(request: BillRequest): PriceBreakdown
  }
  interface "ParkingPricing.BenefitPolicy" as BenefitPolicy <<private nested>> {
    +discount(base: long): long
  }
  class "new BenefitPolicy() { ... }" as AnonymousBenefit <<anonymous class>> {
    +discount(base: long): long
  }
  class PricingProperties <<record>> {
    -version: String
    -freeMinutes: int
    -daytimeStart: LocalTime
    -daytimeEnd: LocalTime
    -dayFirstMinutes: int
    -dayFirstCents: long
    -dayStepMinutes: int
    -dayStepCents: long
    -nightStepMinutes: int
    -nightStepCents: long
    -dailyCapCents: long
    -reservationDiscountBps: int
    -monthlyDiscountBps: int
    -lostCardCents: long
    -longStayHours: long
    -longStaySurchargeBps: int
  }
  BillingController "1" --> "1" BillingService : billing
  BillingService "1" --> "1" ParkingPricing : pricing
  ParkingPricing ..> PricingProperties : bind current config
  ParkingPricing ..> BenefitPolicy : declares and uses nested interface
  AnonymousBenefit ..|> BenefitPolicy : NONE case
  note right of BenefitPolicy
    ParkingPricing 内的 private interface。
    switch 中 NONE 使用图中的匿名类实现；
    RESERVATION 和 MONTHLY 使用 lambda 实现。
    代码没有这三种策略的具名类或独立文件。
  end note
}
@enduml

@startuml
title space-service 设计类图（AI-辅助；字段与签名按实现）
skinparam classAttributeIconSize 0
package "space-service" {
  class SpaceController {
    -operations: SpaceOperations
    +occupy(spaceId: String, key: String, request: OccupancyRequest): ApiResponse<SpaceView>
    +release(spaceId: String, key: String, request: OccupancyRequest): ApiResponse<SpaceView>
    +settle(spaceId: String, key: String, request: OccupancyRequest): ApiResponse<ChargingFeeView>
  }
  class ChargingController {
    -operations: SpaceOperations
    +start(key: String, request: StartRequest): ApiResponse<ChargingView>
    +finish(id: String, key: String, request: FinishRequest): ApiResponse<ChargingView>
  }
  class SpaceOperations {
    -jdbc: JdbcTemplate
    -idempotency: Idempotency
    -rateVersion: String
    -rateCentsPerKwh: long
    +occupy(spaceId: String, parkingSessionId: String, key: String): SpaceView
    +release(spaceId: String, parkingSessionId: String, key: String): SpaceView
    +settle(spaceId: String, parkingSessionId: String, key: String): ChargingFeeView
    +startCharging(chargerId: String, parkingSessionId: String, startTime: String, key: String): ChargingView
    +finishCharging(chargingId: String, endTime: String, energyKwh: BigDecimal, key: String): ChargingView
  }
  class Idempotency {
    -jdbc: JdbcTemplate
    -transactions: TransactionTemplate
    -json: ObjectMapper
    +run<T>(key: String, operation: String, signature: String, resultType: Class<T>, action: Supplier<T>): T
  }
  SpaceController "1" --> "1" SpaceOperations : operations
  ChargingController "1" --> "1" SpaceOperations : operations
  SpaceOperations "1" --> "1" Idempotency : idempotency
}
@enduml

@startuml
title pass-service 设计类图（AI-辅助；字段与签名按实现）
skinparam classAttributeIconSize 0
package "pass-service" {
  class PassController {
    -service: PassService
    ~reserve(key: String, request: CreateReservation): ApiResponse<ReservationView>
    ~pay(id: String, key: String, request: SimulatedPayment): ApiResponse<ReservationPaymentView>
    ~createMonthly(key: String, request: CreateMonthlyPass): ApiResponse<MonthlyPassView>
  }
  class PassService {
    -jdbc: JdbcTemplate
    -spaces: SpaceClient
    -idempotency: IdempotencyStore
    -prepaidCents: long
    -initialBalanceCents: long
    -paymentHoldMinutes: int
    -monthlyDurationDays: int
    ~reserve(key: String, request: CreateReservation): ReservationView
    ~eligibility(plateNumber: String, entryTime: OffsetDateTime, exitTime: OffsetDateTime, spaceType: String, parkingSessionId: String): EligibilityView
    ~createMonthly(key: String, request: CreateMonthlyPass): MonthlyPassView
    ~deduct(key: String, id: String, request: Deduction): DeductionView
  }
  class IdempotencyStore {
    -jdbc: JdbcTemplate
    -json: ObjectMapper
    ~execute<T>(key: String, operation: String, fingerprint: String, type: Class<T>, action: Supplier<T>): T
  }
  interface "SpaceClient" as PassSpaceClient {
    +spaces(type: String): ApiResponse<List<SpaceView>>
  }
  PassController "1" --> "1" PassService : service
  PassService "1" --> "1" IdempotencyStore : idempotency
  PassService "1" --> "1" PassSpaceClient : spaces, read only
}
@enduml

@startuml
title analytics-service 设计类图（AI-辅助；字段与签名按实现）
skinparam classAttributeIconSize 0
package "analytics-service" {
  class TrafficController {
    -service: TrafficService
    ~traffic(from: OffsetDateTime, to: OffsetDateTime, granularity: String): Envelope<TrafficReport>
    ~preview(from: OffsetDateTime, to: OffsetDateTime, granularity: String): Envelope<TrafficReport>
    ~saved(id: String): Envelope<TrafficReport>
  }
  class TrafficService {
    -access: AccessTrafficClient
    -jdbc: JdbcTemplate
    -cache: SavedReportCache
    ~generate(from: OffsetDateTime, to: OffsetDateTime, granularity: String): TrafficReport
    ~preview(from: OffsetDateTime, to: OffsetDateTime, granularity: String): TrafficReport
    ~saved(id: String): TrafficReport
  }
  class SavedReportCache {
    -redis: StringRedisTemplate
    -json: ObjectMapper
    -ttl: Duration
    ~find(id: String): TrafficReport
    ~put(report: TrafficReport): void
  }
  interface AccessTrafficClient {
    +sessions(from: String, to: String): Envelope<List<TrafficSession>>
  }
  class "Envelope<T>" as TrafficEnvelope <<record>> {
    -code: String
    -message: String
    -data: T
    -requestId: String
    ~ok<T>(data: T): Envelope<T>
  }
  class TrafficSession <<record>> {
    -parkingSessionId: String
    -entryTime: OffsetDateTime
    -exitTime: OffsetDateTime
    -status: String
  }
  class TrafficBucket <<record>> {
    -start: OffsetDateTime
    -count: int
  }
  class TrafficReport <<record>> {
    -reportId: String
    -from: OffsetDateTime
    -to: OffsetDateTime
    -granularity: String
    -buckets: List<TrafficBucket>
    -peakBucket: TrafficBucket
    -totalEntries: int
  }
  class TrafficFailure {
    ~code: String
    ~status: HttpStatus
  }
  class TrafficErrors {
    -log: Logger
    ~business(error: TrafficFailure): ResponseEntity<Envelope<Void>>
    ~invalid(error: Exception): ResponseEntity<Envelope<Void>>
    ~database(error: DataAccessException): ResponseEntity<Envelope<Void>>
  }
  TrafficController "1" --> "1" TrafficService : service
  TrafficService "1" --> "1" AccessTrafficClient : Feign, read only
  TrafficService "1" --> "1" SavedReportCache : saved reports only
  TrafficReport "1" --> "0..*" TrafficBucket : buckets
  TrafficErrors ..> TrafficFailure : handles
  note right of TrafficService
    jdbc 仅写 analytics-service 自有报表库；
    原始车流记录仅通过 AccessTrafficClient 只读获取。
    已保存报表读穿 Redis；故障时回源 MySQL。
    实时预览不使用缓存。
  end note
}
@enduml
