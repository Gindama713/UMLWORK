# Copy to .env and replace every placeholder. .env is ignored by Git.
MYSQL_ROOT_PASSWORD=replace-with-mysql-password
REDIS_PASSWORD=replace-with-redis-password
# Nacos 3 requires token and server identity values even in standalone mode.
# Generate a base64 token from at least 32 random bytes; keep all three values private.
NACOS_AUTH_TOKEN=replace-with-base64-token
NACOS_AUTH_IDENTITY_KEY=replace-with-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-identity-value
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m
